# ==============================================================================
# Sigmatic — variáveis de ambiente
#
# Copie este arquivo para `.env` e preencha os valores para o seu ambiente
# local. O `.env` nunca deve ser versionado (já está no .gitignore).
#
# Os valores abaixo já vêm com defaults úteis para desenvolvimento local
# (incluindo `docker compose up`). Troque-os para produção ou para apontar
# a um banco/servidor diferente.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django (config/settings.py)
# ------------------------------------------------------------------------------

# Chave secreta usada para assinar sessões, tokens CSRF, etc.
# Gere uma chave própria por ambiente — nunca reaproveite a de outro projeto
# nem use a chave padrão de desenvolvimento em produção.
# Deixe em branco em dev para usar o fallback inseguro do código; defina um
# valor sempre que DEBUG=False.
SECRET_KEY=

# Ativa o modo de depuração do Django. Use "True" apenas em desenvolvimento
# local; em produção deve ser "False".
DEBUG=True

# Hosts autorizados a servir a aplicação, separados por vírgula
# (ex: localhost,127.0.0.1,sigmatic.sesp.pr.gov.br). Use "*" apenas em
# desenvolvimento local.
ALLOWED_HOSTS=*

# ------------------------------------------------------------------------------
# Banco de dados PostgreSQL (config/settings.py)
#
# Os defaults abaixo casam com o serviço `db` do docker-compose.yml. Se você
# for usar uma instância própria do PostgreSQL (fora do Docker), ajuste-os
# para os dados da sua instância local.
# ------------------------------------------------------------------------------

# Nome do banco de dados local.
DB_NAME=sigmatic_db

# Usuário do PostgreSQL.
DB_USER=postgres

# Senha do usuário do PostgreSQL.
DB_PASSWORD=postgres

# Host do banco de dados. Use "localhost" para uma instância própria ou "db"
# ao rodar via docker-compose (o serviço `web` já sobrescreve isso sozinho).
DB_HOST=localhost

# Porta do PostgreSQL.
DB_PORT=5432

# ------------------------------------------------------------------------------
# Backend FastAPI (fastapi_backend/config.py)
# ------------------------------------------------------------------------------

# URL de conexão do SQLAlchemy usada pelo backend FastAPI. Por padrão aponta
# para um SQLite local; troque por uma URL PostgreSQL se necessário
# (ex: postgresql://usuario:senha@localhost:5432/sigmatic_db).
DATABASE_URL=sqlite:///./compras_gaa.db

# Habilita o envio de e-mails via SMTP (True/False).
SMTP_ENABLED=True

# Servidor SMTP usado para notificações por e-mail. Em desenvolvimento local
# aponta para o Mailhog (docker-compose), que captura os e-mails em vez de
# enviá-los de verdade — acesse http://localhost:8025 para visualizá-los.
# Ao rodar via docker-compose, o serviço `web` já sobrescreve isso sozinho.
SMTP_HOST=localhost

# Porta do servidor SMTP (1025 é a porta SMTP exposta pelo Mailhog).
SMTP_PORT=1025

# Usuário de autenticação SMTP. O Mailhog não exige autenticação; pode ficar
# em branco em dev.
SMTP_USER=

# Senha de autenticação SMTP. O Mailhog não exige autenticação; pode ficar
# em branco em dev.
SMTP_PASSWORD=
